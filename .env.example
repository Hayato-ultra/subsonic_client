# Subsonic client – gonic connection settings
# -------------------------------------------------
# Required variables (fill in your gonic instance details):
GONIC_URL=http://YOUR_GONIC_HOST:4553
GONIC_USER=your_subsonic_user
GONIC_PASSWORD=your_subsonic_password

# Optional – override defaults (see app/config.py)
# STREAM_BITRATE=320   # bitrate in kbps for streaming (default 320)
# APP_PORT=8000       # FastAPI server port (default 8000)
# APP_HOST=0.0.0.0    # bind address (default 0.0.0.0)